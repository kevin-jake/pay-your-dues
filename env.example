# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=pay_your_dues
DB_SSL_MODE=disable

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=debug
# Output format: "console" for human-readable CLI logs (default),
# "json" for structured logs suited to aggregation (e.g. Grafana Loki)
LOG_FORMAT=console

# S3 Configuration
S3_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Webhook Notification Configuration
# Telegram Bot Configuration (app-level, shared by all users)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Secret token to verify webhook requests from Telegram (optional but recommended for production)
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here
# Use long polling instead of webhook (set to "true" for local development without a domain)
# In production, set to "false" and configure a webhook URL instead
TELEGRAM_POLLING_MODE=true

# Webhook Settings
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_RETRY=3
WEBHOOK_RATE_LIMIT=10

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=notifications.topic
RABBITMQ_SEND_QUEUE=notifications.send
RABBITMQ_RETRY_QUEUE=notifications.send.retry
RABBITMQ_DLQ=notifications.send.dlq

# Notification Worker / Scheduler
NOTIFICATION_WORKER_PORT=8081
SCHEDULER_INTERVAL=30s
SCHEDULER_BATCH_SIZE=200
SCHEDULER_LOCK_ID=8675309
CONSUMER_PREFETCH=10
CONSUMER_CONCURRENCY=8
NOTIFICATION_WORKER_INTERVAL=1m
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_MAX_RETRY=3
NOTIFICATION_RETRY_TTL=30s

# SMTP (used by notification worker)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@payyourdues.com
SMTP_FROM_NAME=Pay Your Dues

# Twilio SMS (used by notification worker)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=