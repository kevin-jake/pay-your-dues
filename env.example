# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=pay_your_dues
DB_SSL_MODE=disable

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=debug

# S3 Configuration
S3_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Webhook Notification Configuration
# Telegram Bot Configuration (app-level, shared by all users)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Secret token to verify webhook requests from Telegram (optional but recommended for production)
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here
# Use long polling instead of webhook (set to "true" for local development without a domain)
# In production, set to "false" and configure a webhook URL instead
TELEGRAM_POLLING_MODE=true

# Webhook Settings
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_RETRY=3
WEBHOOK_RATE_LIMIT=10